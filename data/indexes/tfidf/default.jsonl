{"doc_id": "6e944fd4-1d64-427a-8e9c-77d3b342b70f", "text": "Artificial intelligence systems improve automation, unlock insights, and require careful governance. Teams should evaluate data quality, model drift, and human oversight to maintain trust.", "meta": {"url": "https://example.com/ai-governance", "content_type": "text/plain", "parser": "text", "source": "url", "doc_id": "6e944fd4-1d64-427a-8e9c-77d3b342b70f"}, "tags": ["ai", "com", "example", "example.com", "governance"], "tokens": ["artificial", "intelligence", "systems", "improve", "automation", "unlock", "insights", "and", "require", "careful", "governance", "teams", "should", "evaluate", "data", "quality", "model", "drift", "and", "human", "oversight", "to", "maintain", "trust"]}
